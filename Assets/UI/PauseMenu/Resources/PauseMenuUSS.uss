.Menu-Background {
    background-color: rgba(87, 85, 85, 0.24);
    align-self: stretch;
    align-items: center;
    justify-content: space-around;
}

.Menu-Container {
    color: rgb(27, 27, 27);
    background-color: rgb(113, 113, 113);
    align-self: center;
    align-items: center;
    flex-grow: 1;
    width: 30%;
    height: 80%;
    max-height: 80%;
    max-width: 30%;
    min-width: 30%;
    min-height: 80%;
    justify-content: space-around;
}

.Menu-Header {
    flex-basis: auto;
    flex-grow: 1;
    align-self: stretch;
    justify-content: flex-start;
    font-size: 24px;
}

.Menu-Button {
    flex-basis: initial;
    flex-grow: 0;
    align-self: stretch;
    justify-content: space-around;
    margin-top: 25px;
    margin-right: 25px;
    margin-bottom: 25px;
    margin-left: 25px;
    font-size: 20px;
}
