<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" xsi="http://www.w3.org/2001/XMLSchema-instance" engine="UnityEngine.UIElements" editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI/PauseMenu/Resources/PauseMenuUSS.uss?fileID=7433441132597879392&amp;guid=af28a79679e40ba4484c79f6ffa52b22&amp;type=3#PauseMenuUSS" />
    <ui:VisualElement name="MenuRoot" class="Menu-Background" style="flex-grow: 1; visibility: hidden;">
        <ui:VisualElement name="MenuContainer" class="Menu-Container" style="flex-grow: 1; height: 50%; max-height: 50%; min-height: 50%;">
            <ui:Label tabindex="-1" text="Game Paused" parse-escape-sequences="true" display-tooltip-when-elided="true" style="left: auto; top: auto; font-size: 28px; -unity-font-style: bold; flex-grow: 0;" />
            <ui:VisualElement name="ButtonContainer" style="flex-grow: 1; align-self: stretch; flex-basis: 70%; align-items: center; flex-direction: column; justify-content: center;">
                <ui:Button text="Resume Game" parse-escape-sequences="true" display-tooltip-when-elided="true" name="ResumeButton" class="Menu-Button" />
                <ui:Button text="Return to Main Menu" parse-escape-sequences="true" display-tooltip-when-elided="true" name="MainMenuButton" class="Menu-Button" />
            </ui:VisualElement>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
