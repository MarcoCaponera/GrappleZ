.Menu-Background {
    background-color: rgba(106, 106, 106, 0.82);
    -unity-background-image-tint-color: rgb(77, 77, 77);
    align-self: stretch;
    margin-top: 15%;
    margin-right: 20%;
    margin-bottom: 15%;
    margin-left: 20%;
    flex-grow: 1;
    flex-basis: auto;
}

.Menu-Text {
    font-size: 14px;
    align-self: stretch;
}

.Menu-Button {
    justify-content: flex-start;
    align-self: auto;
    font-size: 75%;
    flex-grow: 1;
    margin-top: 5px;
    margin-right: 5px;
    margin-bottom: 5px;
    margin-left: 5px;
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
    align-items: auto;
    flex-basis: auto;
    height: 70%;
}
